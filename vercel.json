{
  "version": 2,
  "builds": [
    {
      "src": "public/build/**/*",
      "use": "@vercel/static"

    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "public/index.php"
    }
  ],
  "outputDirectory": "public/build",
  "installCommand": "npm install",
  "buildCommand": "npm run build"
}
