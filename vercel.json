{
  "version": 2,
  "builds": [
    {
      "src": "public/build/**/*",
      "use": "@vercel/static"
    }
  ],
  "outputDirectory": "public/build",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/build/index.html"
    }
  ]
}
